<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
					 namespace="NHibernate.Test.NHSpecificTest.GH1306"
					 assembly="NHibernate.Test">

	<class name="Parent" table="GH1306Parent">
		<id name="Id" type="Int64" unsaved-value="none">
			<generator class="assigned"/>
		</id>
		<set name="Children" inverse="true" cascade="none" lazy="extra" fetch="select">
			<key column="ParentId"/>
			<one-to-many class="Child"/>
			<filter name="statusFilter" condition="Status = :status"/>
		</set>
	</class>

	<class name="Child" table="GH1306Child">
		<id name="Id" type="Int64" unsaved-value="none">
			<generator class="assigned"/>
		</id>
		<property name="ParentId"/>
		<property name="Status"/>
	</class>

	<filter-def name="statusFilter">
		<filter-param name="status" type="Int32"/>
	</filter-def>

</hibernate-mapping>
